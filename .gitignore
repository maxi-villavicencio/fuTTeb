# ==========================================================================
# Bet Analyzer AI — .gitignore (Python + Node + IntelliJ/PyCharm)
# ==========================================================================

# --- Entornos virtuales de Python ---
.venv/
venv/
env/
ENV/

# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example

# --- Cachés y compilados de Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Frontend ---
node_modules/
.next/
out/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IntelliJ / PyCharm ---
.idea/
*.iml
*.iws
*.ipr

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
*.log
*.swp
.vscode/
