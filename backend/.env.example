# Ejemplo de variables de entorno — Bet Analyzer AI
#
# NOTA: la aplicación lee el .env de la RAÍZ del proyecto, no el de backend/.
# Copiá el archivo ".env.example" de la raíz a ".env" (en la raíz) y completá
# los valores. Este archivo se mantiene solo como referencia.

APP_NAME=Bet Analyzer AI

# --- Conexión a SQL Server ---
DB_SERVER=MAXI\SQLEXPRESS
DB_NAME=BetAnalyzerAI
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Cifrado (Driver 18) ---
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=optional

# --- Alternativa: cadena completa (opcional, tiene prioridad si se define) ---
# DATABASE_URL=
