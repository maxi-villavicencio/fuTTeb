# Ejemplo de variables de entorno del backend / engine.
# Copiar a ".env" y rellenar con valores reales. NO subir el .env al repo.

# Nombre de la aplicación
APP_NAME=Bet Analyzer AI

# --- Conexión a SQL Server (opción A: por componentes) ---
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=bet_analyzer
DB_USER=usuario
DB_PASSWORD=cambia_esta_password

# --- Conexión a SQL Server (opción B: cadena completa) ---
# Si se define DATABASE_URL, tiene prioridad sobre los componentes de arriba.
# Ejemplo (SQLAlchemy + pyodbc):
# DATABASE_URL=mssql+pyodbc://usuario:password@localhost/bet_analyzer?driver=ODBC+Driver+17+for+SQL+Server
