# Ejemplo de variables de entorno — Bet Analyzer AI
# Copiar este archivo a ".env" (en la raíz) y rellenar con valores reales.
# El .env NO se sube al repositorio (está en .gitignore).

# Nombre de la aplicación
APP_NAME=Bet Analyzer AI

# --- Conexión a SQL Server ---
# Instancia nombrada: usar la barra invertida tal cual (MAXI\SQLEXPRESS).
DB_SERVER=MAXI\SQLEXPRESS
DB_NAME=BetAnalyzerAI
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Driver ODBC. En este proyecto se usa el 18.
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Cifrado (Driver 18) ---
# El Driver 18 exige cifrado por defecto. En local, sin certificado válido,
# hay que confiar en el certificado del servidor o la conexión falla.
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ENCRYPT=optional

# --- Alternativa: cadena completa ya formada (opcional) ---
# Si se define, tiene prioridad sobre los componentes de arriba.
# DATABASE_URL=
